{
	"authors": [
		"Freddie Hornsby"
	],
	"copyright": "Copyright © 2026, Freddie Hornsby",
	"description": "A PDF engine for Mayfair on PDFium, downloaded prebuilt or the system's, found at run time",
	"license": "MIT",
	"name": "mayfair-pdfium",
	"targetType": "library",
	"dependencies": {
		"mayfair-pdf": {
			"path": "../mayfair-pdf"
		}
	},
	"preGenerateCommands": [
		"\"$DUB\" run --quiet --single \"$PACKAGE_DIR/fetch.d\" -- \"$PACKAGE_DIR\""
	],
	"copyFiles-linux": [
		"pdfium/lib/libpdfium.so"
	],
	"copyFiles-osx": [
		"pdfium/lib/libpdfium.dylib"
	],
	"copyFiles-windows": [
		"pdfium/bin/pdfium.dll"
	],
	"libs-posix": [
		"dl"
	],
	"toolchainRequirements": {
		"frontend": ">=2.111.0",
		"gdc": "no"
	}
}
