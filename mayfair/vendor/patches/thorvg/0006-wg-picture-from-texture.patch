+// a GPU texture, drawn as it is whenever the canvas is drawn: never cached
+tvg::Loader* LoaderMgr::loader(void* texture, uint32_t w, uint32_t h, ColorSpace cs)
+{
+    auto loader = new RawLoader;
+    if (loader->open(texture, w, h, cs)) return loader;
+    delete (loader);
+    return nullptr;
+}
