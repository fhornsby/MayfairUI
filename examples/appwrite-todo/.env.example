# Your Appwrite project's values. Copy this file to .env and fill them in: .env is ignored by
# git, so they stay on your machine. README.md says how to set the project up, and where in the
# Appwrite console each value is.

# The API endpoint, with your project's region, as the console's project settings show it
APPWRITE_ENDPOINT=https://<REGION>.cloud.appwrite.io/v1

# The project's ID
APPWRITE_PROJECT=<PROJECT_ID>

# The IDs of the database, and of the table in it that the to-dos go in
APPWRITE_DATABASE=<DATABASE_ID>
APPWRITE_TABLE=<TABLE_ID>
