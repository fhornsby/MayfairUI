<?xml version="1.0" encoding="UTF-8"?>
<?import files?>
<?import preview?>
<!--
    The window's content, as Overleaf lays it out: the project's files down the left, the file
    being edited in the middle, and the PDF it makes on the right, side by side in a SplitPane
    whose dividers are dragged to share out the room. The files keep their width as the window's
    resized; the editor and the PDF share what's left.

    The files and the PDF are widgets of the app's own, each with a view of its own: files.xml
    and preview.xml. Workspace, in workspace.d, is this view's controller.
-->
<SplitPane id="split" dividerPositions="0.17 0.58">
    <FilesPane id="files" minWidth="160" SplitPane.keepSize="true"/>

    <!-- The editor: a tab for each file open, and a line saying where the caret is -->
    <Column id="editorPane" styleClass="page" minWidth="260">
        <TabPane id="tabs" grow="1"/>
        <Row styleClass="status-line" spacing="18" alignment="centreLeft">
            <Label id="problemsLabel"/>
            <Label id="serverLabel"/>
            <Row grow="1"/>
            <Label id="positionLabel"/>
            <Label id="mainLabel"/>
        </Row>
    </Column>

    <PreviewPane id="preview" minWidth="260"/>
</SplitPane>
